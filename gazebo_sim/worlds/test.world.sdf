<?xml version="1.0"?>
<sdf version="1.9">
  <world name="quadcopter_world">
    <gravity>0 0 -9.81</gravity>
    <!-- Gazebo Harmonic uses the installed DART physics engine. -->
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="landing_pad">
      <static>true</static>
      <pose>4 0 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>1.0</radius><length>0.05</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>1.0</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.05 0.35 0.05 1</ambient><diffuse>0.05 0.5 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_tower">
      <static>true</static>
      <pose>3 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 3.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 3.0</size></box></geometry>
          <material><ambient>0.45 0.12 0.05 1</ambient><diffuse>0.6 0.18 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_wall_x">
      <static>true</static>
      <pose>-3 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.35 5.0 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.35 5.0 2.0</size></box></geometry>
          <material><ambient>0.12 0.12 0.45 1</ambient><diffuse>0.15 0.15 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_wall_y">
      <static>true</static>
      <pose>0 4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.0 0.35 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.35 1.5</size></box></geometry>
          <material><ambient>0.4 0.4 0.08 1</ambient><diffuse>0.55 0.55 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://x500</uri>
      <name>x500</name>
      <pose>0 0 1 0 0 0</pose>
    </include>
  </world>
</sdf>
